# Settings for running the tool in a container. Copy this file to .env (beside docker-compose.yml) and fill it in.
# Never commit .env and never send it to anyone. This file holds names only.
#
# How to write a value:
#   - A line that starts with # is switched off. An empty value is NOT the same as a switched-off line.
#   - If a value contains $ or #, or begins or ends with a space, put it in single quotes: SMTP_PASSWORD='pa$$word'
#   - Use `docker compose`, never `docker run --env-file`: plain docker keeps the quotes as part of the value.

# ---------- the container ----------
# Required. Your time zone, so the times on the pages are your local time. Names look like Asia/Kolkata or America/Chicago.
TZ=
# Optional. The port on this computer; the UI is then at http://127.0.0.1:<port>/ . Defaults to 8010.
# LCOM_PORT=
# Optional. The folder on this computer that holds all your work. Defaults to the folder "data" beside docker-compose.yml.
# Never a synced folder (OneDrive, Dropbox, a network share), and never the folder that holds the program's source.
# LCOM_DATA=

# ---------- search ----------
# Required for a search. Anthropic API key (also used to read a seller's reply and to write listing drafts).
ANTHROPIC_API_KEY=
# Required for a search. Nimble API key.
NIMBLE_API_KEY=

# ---------- emails to sellers ----------
# Required to send. Mail server, login and password.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
# Optional. Mail server port; 587 when switched off.
# SMTP_PORT=
# Optional. The From address; the mail login when switched off.
# SMTP_FROM=
# Optional. The name signed at the end of each email.
# SENDER_NAME=
# Required to send (sending is refused while it is empty). One line in double quotes, with \n between the lines:
# "Company Name\n123 Example St\nCity, ST 12345"
SHIPPING_ADDRESS=

# ---------- listing drafts ----------
# Required to write listing drafts. Your Walmart brand name.
BRAND_NAME=

# ---------- the UI ----------
# Optional. The name shown at the top of the pages.
# UI_APP_NAME=
# Optional. Days the UI keeps finished job logs; 30 when switched off, 0 keeps them for ever.
# UI_LOG_RETENTION_DAYS=

# ---------- tracing (only for the people who maintain the tool and run their own Langfuse) ----------
# Optional. 1 switches run tracing on. Anything else, or switched off, means no tracing at all.
# OBS_ENABLED in this file has no effect in the container; only LCOM_TRACING does.
# LCOM_TRACING=
# Optional. Where Langfuse is. Defaults to a Langfuse on this computer, reached as http://host.docker.internal:3000 .
# Never write localhost here: inside the container that means the container itself.
# LCOM_LANGFUSE_URL=
# Needed only with LCOM_TRACING=1.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# Optional.
# OBS_ENV=
# OBS_CAPTURE_CONTENT=
# OBS_FLUSH_TIMEOUT=
