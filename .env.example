# Copy to .env and fill in. Never commit .env. Optional variables are commented out: remove the leading # only if you
# need them (an empty value is NOT the same as unset: an empty SMTP_PORT breaks sending, an empty OBS_CAPTURE_CONTENT
# turns prompt capture off). Values set in the shell win over .env.
# "Required" means that agent will not work (or will refuse to send) without it.

# ---------- sourcing_agent.py (search) ----------
# Required. Anthropic API key (also used by email_agent reply and content_agent generate).
ANTHROPIC_API_KEY=
# Required. Nimble API key, used as the bearer token for the Nimble MCP server.
NIMBLE_API_KEY=

# ---------- email_agent.py ----------
# Required for `send`. SMTP server host.
SMTP_HOST=
# Optional. SMTP port; defaults to 587.
# SMTP_PORT=
# Required for `send`. SMTP login.
SMTP_USER=
# Required for `send`. SMTP password.
SMTP_PASSWORD=
# Optional. From address; defaults to SMTP_USER.
# SMTP_FROM=
# Optional. Name signed at the end of each email.
# SENDER_NAME=
# Required for a real `send` (it refuses while unset or still the default). One line in double quotes, \n between lines,
# e.g. "Company Name\n123 Example St\nCity, ST 12345". This is the sample shipping address shown to sellers.
SHIPPING_ADDRESS=
# Needs ANTHROPIC_API_KEY (above) for `reply`, which summarizes a seller's reply.
# The test recipient is NOT a variable: use  python email_agent.py send <results.xlsx> --test-recipient you@example.com

# ---------- content_agent.py ----------
# Required for `generate` only (not for facts-template, check or --dry-run). Your Walmart brand name, max length checked in code.
BRAND_NAME=
# Also needs ANTHROPIC_API_KEY (above).

# ---------- decision_agent.py ----------
# No variables. (It makes no network or model calls.)

# ---------- order_sheet.py ----------
# Optional. Full path to the xlsx skill's recalc.py, for the extra LibreOffice recalculation check.
# If unset, the script looks under ~\.claude\skills for it; if not found the extra check is skipped.
# ORDER_SHEET_RECALC_PY=

# ---------- tracing (observability.py, all agents) ----------
# Optional. Set to 1 to send traces to Langfuse; anything else (or unset) = tracing completely off.
# OBS_ENABLED=
# Required only when OBS_ENABLED=1. Langfuse project keys.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# Required only when OBS_ENABLED=1 on a self-hosted server (e.g. http://localhost:3000); defaults to Langfuse Cloud.
# LANGFUSE_HOST is accepted as an older name for the same thing.
# LANGFUSE_BASE_URL=
# Optional. Environment tag on traces; defaults to dev.
# OBS_ENV=
# Optional. Comma list of agents whose prompt/response text is sent (replaces the default list in observability.py;
# empty = none). decision_agent and order_sheet can never be switched on.
# OBS_CAPTURE_CONTENT=
# Optional. Seconds the exit-time flush may take; defaults to 5.
# OBS_FLUSH_TIMEOUT=

# ---------- web UI (run_ui.py) ----------
# Optional. Where the UI listens; defaults 127.0.0.1 and 8000. Any non-loopback host is refused unless UI_ALLOW_NON_LOOPBACK=1
# (the UI has no login).
# UI_HOST=
# UI_PORT=
# UI_ALLOW_NON_LOOPBACK=
# Optional. Project folder holding the agents and their data (default: the folder run_ui.py is in), and where job logs go
# (default: ui_data inside the project folder). A container can mount these.
# PROJECT_DIR=
# UI_DATA_DIR=

